{
    "name": "@suite-mini/desktop-app-renderer",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "type-check:watch": "yarn type-check -- --watch",
        "lint:styles": "stylelint './src/**/*{.ts,.tsx}' --cache --config ../../.stylelintrc",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "dev": "TS_NODE_PROJECT=\"tsconfig.json\" webpack --config ./webpack.config.ts",
        "build": "NODE_ENV=production TS_NODE_PROJECT=\"tsconfig.json\" webpack --config ./webpack.config.ts"
    },
    "dependencies": {
        "@suite-common/analytics-redux": "workspace:*",
        "@suite-common/firmware-authenticity": "workspace:*",
        "@suite-common/message-system": "workspace:*",
        "@suite-common/networks": "workspace:*",
        "@suite-common/react-query": "workspace:*",
        "@suite/authenticity-checks": "workspace:*",
        "@suite/debug": "workspace:*",
        "@suite/desktop-app-api": "workspace:*",
        "@suite/desktop-app-api-electron": "workspace:*",
        "@suite/device": "workspace:*",
        "@suite/message-system": "workspace:*",
        "@suite/platform-encryption-electron": "workspace:*",
        "@suite/router": "workspace:*",
        "@suite/tor-desktop": "workspace:*",
        "@trezor/components": "workspace:*",
        "@trezor/connect-electron": "workspace:*",
        "@trezor/dependency-injection": "workspace:*",
        "@trezor/network-ethereum-suite-common": "workspace:*",
        "@trezor/redux-utils": "workspace:*",
        "@trezor/suite": "workspace:*",
        "@trezor/theme": "workspace:*",
        "core-js": "^3.50.0",
        "history": "^5.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-redux": "9.3.0",
        "styled-components": "^6.5.3"
    },
    "devDependencies": {
        "@suite-common/flags": "workspace:*",
        "@suite-common/suite-config": "workspace:*",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "copy-webpack-plugin": "^14.0.0",
        "html-webpack-plugin": "5.6.8",
        "postcss-styled-syntax": "^0.7.3",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "webpack": "5.111.1",
        "webpack-cli": "^7.2.3",
        "webpack-merge": "^6.0.1"
    }
}
